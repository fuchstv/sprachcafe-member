{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "SprachCafe Member App Design System",
  "version": "1.0.0",
  "color": {
    "brand": {
      "red": {
        "$value": "#8B1E2D",
        "$type": "color",
        "$description": "SprachCafe Red - Primary brand color"
      },
      "darkRed": {
        "$value": "#5C141E",
        "$type": "color",
        "$description": "Deep accent red for contrast and shadows"
      },
      "gold": {
        "$value": "#D4AF37",
        "$type": "color",
        "$description": "SprachCafe Gold - Secondary brand accent"
      },
      "cream": {
        "$value": "#FAF5EB",
        "$type": "color",
        "$description": "SprachCafe Warm Cream - Primary scaffold background"
      }
    },
    "neutral": {
      "dark": {
        "$value": "#1D1B1A",
        "$type": "color",
        "$description": "Dark charcoal for typography and high contrast elements"
      },
      "cardBackground": {
        "$value": "#1D1B1A",
        "$type": "color",
        "$description": "Dark card background fallback"
      },
      "white": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Clean white for surface cards and containers"
      },
      "border": {
        "$value": "#E2D8CC",
        "$type": "color",
        "$description": "Warm border outline for cards and QR container"
      },
      "gray": {
        "$value": "#808080",
        "$type": "color",
        "$description": "Muted secondary text color"
      }
    },
    "tier": {
      "silver": {
        "gradientStart": { "$value": "#94A3B8", "$type": "color" },
        "gradientEnd": { "$value": "#475569", "$type": "color" }
      },
      "gold": {
        "gradientStart": { "$value": "#8B1E2D", "$type": "color" },
        "gradientEnd": { "$value": "#4A0E18", "$type": "color" }
      },
      "platinum": {
        "gradientStart": { "$value": "#1E293B", "$type": "color" },
        "gradientEnd": { "$value": "#0F172A", "$type": "color" }
      },
      "company": {
        "gradientStart": { "$value": "#075985", "$type": "color" },
        "gradientEnd": { "$value": "#0C4A6E", "$type": "color" }
      }
    },
    "status": {
      "coffeeHighlight": {
        "$value": "#FDE047",
        "$type": "color",
        "$description": "Vibrant coffee counter highlight color"
      }
    }
  },
  "dimension": {
    "radius": {
      "card": { "$value": "24px", "$type": "dimension" },
      "modal": { "$value": "28px", "$type": "dimension" },
      "benefit": { "$value": "14px", "$type": "dimension" },
      "button": { "$value": "16px", "$type": "dimension" },
      "qr": { "$value": "16px", "$type": "dimension" },
      "badge": { "$value": "9999px", "$type": "dimension" }
    },
    "spacing": {
      "xs": { "$value": "4px", "$type": "dimension" },
      "sm": { "$value": "8px", "$type": "dimension" },
      "md": { "$value": "12px", "$type": "dimension" },
      "base": { "$value": "16px", "$type": "dimension" },
      "lg": { "$value": "20px", "$type": "dimension" },
      "xl": { "$value": "24px", "$type": "dimension" }
    },
    "card": {
      "height": { "$value": "210px", "$type": "dimension" },
      "borderWidth": { "$value": "2px", "$type": "dimension" }
    }
  },
  "typography": {
    "fontFamily": {
      "body": { "$value": "system-ui, -apple-system, Roboto, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "badge": { "$value": "10px", "$type": "fontSize" },
      "headerLabel": { "$value": "11px", "$type": "fontSize" },
      "bodySmall": { "$value": "12px", "$type": "fontSize" },
      "body": { "$value": "13px", "$type": "fontSize" },
      "title": { "$value": "18px", "$type": "fontSize" },
      "cardName": { "$value": "22px", "$type": "fontSize" }
    }
  }
}
